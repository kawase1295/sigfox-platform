#!/usr/bin/env bash
# Single entry point for pre-merge checks, shared by local runs and GitHub Actions.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> install"
# Why --ignore-scripts + explicit rebuild: local npm runs with ignore-scripts=true and CI does not;
# rebuilding only the packages that need native setup keeps both environments identical.
npm ci --ignore-scripts --no-audit --no-fund
npm rebuild workerd esbuild --ignore-scripts=false

echo "==> biome"
npx biome ci .

echo "==> types"
npx cf workers types
npx tsc -b

echo "==> test"
npx vitest run

echo "==> wrangler.jsonc drift"
node scripts/gen-wrangler.ts
if ! git diff --exit-code -- wrangler.jsonc; then
	echo "wrangler.jsonc is out of date. Run 'npm run gen:wrangler' and commit the result." >&2
	exit 1
fi
