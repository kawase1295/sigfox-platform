{
	"name": "sigfox-platform",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#shared/*": "./shared/*.ts",
		"#quickjs.wasm": "@jitl/quickjs-ng-wasmfile-release-sync/wasm"
	},
	"scripts": {
		"dev": "cf dev",
		"build": "vite build",
		"test": "vitest run",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --persist-to .cloudflare/state",
		"gen:wrangler": "node scripts/gen-wrangler.ts",
		"deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
	},
	"dependencies": {
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@hono/zod-validator": "0.9.1",
		"@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
		"@lezer/highlight": "1.2.5",
		"@tanstack/react-query": "5.104.2",
		"@tanstack/react-router": "1.170.44",
		"codemirror": "6.0.2",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.13",
		"jose": "6.2.12",
		"maplibre-gl": "6.14.0",
		"quickjs-emscripten-core": "0.32.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/config": "0.24.1",
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
		"@cloudflare/vitest-plugin": "1.4.0",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"cf": "1.0.0-beta.14",
		"drizzle-kit": "0.31.11",
		"happy-dom": "21.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "4.1.11",
		"wrangler": "4.149.0"
	}
}
